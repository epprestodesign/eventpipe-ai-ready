{
  "component": {
    "avatar": {
      "size": {
        "xs": {
          "width":    { "$type": "dimension", "$value": "24px" },
          "height":   { "$type": "dimension", "$value": "24px" },
          "fontSize": { "$type": "dimension", "$value": "10px" }
        },
        "sm": {
          "width":    { "$type": "dimension", "$value": "32px" },
          "height":   { "$type": "dimension", "$value": "32px" },
          "fontSize": { "$type": "dimension", "$value": "13px" }
        },
        "md": {
          "width":    { "$type": "dimension", "$value": "40px" },
          "height":   { "$type": "dimension", "$value": "40px" },
          "fontSize": { "$type": "dimension", "$value": "16px" }
        },
        "lg": {
          "width":    { "$type": "dimension", "$value": "56px" },
          "height":   { "$type": "dimension", "$value": "56px" },
          "fontSize": { "$type": "dimension", "$value": "22px" }
        },
        "xl": {
          "width":    { "$type": "dimension", "$value": "72px" },
          "height":   { "$type": "dimension", "$value": "72px" },
          "fontSize": { "$type": "dimension", "$value": "28px" }
        }
      },

      "borderRadius": {
        "circular": { "$type": "dimension", "$value": "50%" },
        "rounded":  { "$type": "dimension", "$value": "4px" },
        "square":   { "$type": "dimension", "$value": "0px" }
      },

      "background": { "$type": "color", "$value": "{semantic.color.neutral.medium}" },
      "color":      { "$type": "color", "$value": "{semantic.color.text.onBrand}" }
    }
  }
}
