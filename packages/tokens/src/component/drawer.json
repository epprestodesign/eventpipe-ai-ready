{
  "component": {
    "drawer": {
      "background":         { "$type": "color",     "$value": "{semantic.color.background.paper}" },
      "borderRadius":       { "$type": "dimension", "$value": "0px" },
      "transitionDuration": { "$type": "duration",  "$value": "225ms" },

      "shadow": {
        "$type": "shadow",
        "$value": "{semantic.elevation.panel}"
      },

      "width":  { "$type": "dimension", "$value": "280px" },

      "header": {
        "paddingY": { "$type": "dimension", "$value": "16px" },
        "paddingX": { "$type": "dimension", "$value": "24px" }
      },

      "body": {
        "paddingY": { "$type": "dimension", "$value": "8px" },
        "paddingX": { "$type": "dimension", "$value": "0px" }
      }
    }
  }
}
