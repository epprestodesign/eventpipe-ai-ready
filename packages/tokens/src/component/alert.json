          "background": { "$type": "color", "$value": "{semantic.color.status.successBg}" },
          "text":       { "$type": "color", "$value": "{semantic.color.status.successText}" },
          "icon":       { "$type": "color", "$value": "{semantic.color.status.successText}" },
          "border":     { "$type": "color", "$value": "transparent" }
        },
        "filled": {
          "background": { "$type": "color", "$value": "{semantic.color.status.success}" },
          "text":       { "$type": "color", "$value": "{semantic.color.text.onBrand}" },
