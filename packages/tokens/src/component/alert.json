{
  "component": {
    "alert": {
      "borderRadius": { "$type": "dimension", "$value": "{semantic.radius.sm}" },
      "borderWidth":  { "$type": "dimension", "$value": "1px" },
      "iconGap":      { "$type": "dimension", "$value": "12px" },
      "actionGap":    { "$type": "dimension", "$value": "16px" },

      "padding": {
        "xs": { "y": { "$type": "dimension", "$value": "6px"  }, "x": { "$type": "dimension", "$value": "10px" } },
        "sm": { "y": { "$type": "dimension", "$value": "8px"  }, "x": { "$type": "dimension", "$value": "12px" } },
        "md": { "y": { "$type": "dimension", "$value": "12px" }, "x": { "$type": "dimension", "$value": "16px" } },
        "lg": { "y": { "$type": "dimension", "$value": "16px" }, "x": { "$type": "dimension", "$value": "20px" } },
        "xl": { "y": { "$type": "dimension", "$value": "20px" }, "x": { "$type": "dimension", "$value": "24px" } }
      },

      "error": {
        "standard": {
          "background": { "$type": "color", "$value": "{semantic.color.status.errorBg}" },
          "text":       { "$type": "color", "$value": "{semantic.color.status.errorText}" },
          "icon":       { "$type": "color", "$value": "{semantic.color.status.errorText}" },
          "border":     { "$type": "color", "$value": "transparent" }
        },
        "filled": {
          "background": { "$type": "color", "$value": "{semantic.color.status.error}" },
          "text":       { "$type": "color", "$value": "{semantic.color.text.onBrand}" },
          "icon":       { "$type": "color", "$value": "{semantic.color.text.onBrand}" },
          "border":     { "$type": "color", "$value": "transparent" }
        },
        "outlined": {
          "background": { "$type": "color", "$value": "transparent" },
          "text":       { "$type": "color", "$value": "{semantic.color.status.error}" },
          "icon":       { "$type": "color", "$value": "{semantic.color.status.error}" },
          "border":     { "$type": "color", "$value": "{semantic.color.status.error}" }
        },
        "soft": {
          "background": { "$type": "color", "$value": "{semantic.color.status.errorBg}" },
          "text":       { "$type": "color", "$value": "{semantic.color.status.error}" },
          "icon":       { "$type": "color", "$value": "{semantic.color.status.error}" },
          "border":     { "$type": "color", "$value": "{semantic.color.status.errorBorder}" }
        }
      },

