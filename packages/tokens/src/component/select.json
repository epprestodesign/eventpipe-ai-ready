{
  "component": {
    "select": {
      "borderRadius": { "$type": "dimension", "$value": "{semantic.radius.sm}" },
      "fontFamily":   { "$type": "fontFamily", "$value": "{semantic.typography.fontFamily}" },

      "border": {
        "width":      { "$type": "dimension", "$value": "1px" },
        "widthFocus": { "$type": "dimension", "$value": "2px" },
        "default":    { "$type": "color",     "$value": "{semantic.color.border.strong}" },
        "hover":      { "$type": "color",     "$value": "{semantic.color.text.primary}" },
        "focus":      { "$type": "color",     "$value": "{semantic.color.focus.ring}" },
        "error":      { "$type": "color",     "$value": "{semantic.color.status.error}" },
        "disabled":   { "$type": "color",     "$value": "{semantic.color.border.default}" }
      },

      "background": {
        "outlined": { "$type": "color", "$value": "{semantic.color.surface.default}" },
        "filled":   { "$type": "color", "$value": "{semantic.color.background.default}" },
        "disabled": { "$type": "color", "$value": "{semantic.color.background.default}" }
      },

      "input": {
        "color":            { "$type": "color", "$value": "{semantic.color.text.primary}" },
        "colorDisabled":    { "$type": "color", "$value": "{semantic.color.text.disabled}" },
        "colorPlaceholder": { "$type": "color", "$value": "{semantic.color.text.secondary}" },
        "fontSize": {
          "sm": { "$type": "dimension", "$value": "{semantic.typography.body2.fontSize}" },
          "md": { "$type": "dimension", "$value": "{semantic.typography.body1.fontSize}" },
          "lg": { "$type": "dimension", "$value": "{semantic.typography.body1.fontSize}" }
        }
      },

      "label": {
        "color":         { "$type": "color",     "$value": "{semantic.color.text.secondary}" },
        "colorFocus":    { "$type": "color",     "$value": "{semantic.color.focus.ring}" },
        "colorError":    { "$type": "color",     "$value": "{semantic.color.status.error}" },
        "colorDisabled": { "$type": "color",     "$value": "{semantic.color.text.disabled}" },
        "translateX":    { "$type": "dimension", "$value": "14px" },
        "translateY": {
          "sm": { "$type": "dimension", "$value": "9px" },
          "md": { "$type": "dimension", "$value": "13px" },
          "lg": { "$type": "dimension", "$value": "17px" }
        },
        "translateYFilled": {
          "sm": { "$type": "dimension", "$value": "14px" },
          "md": { "$type": "dimension", "$value": "16px" },
          "lg": { "$type": "dimension", "$value": "19px" }
        },
        "fontSize": {
          "sm": { "$type": "dimension", "$value": "{semantic.typography.caption.fontSize}" },
          "md": { "$type": "dimension", "$value": "{semantic.typography.body2.fontSize}" },
          "lg": { "$type": "dimension", "$value": "{semantic.typography.body1.fontSize}" }
        }
      },

      "helperText": {
        "color":         { "$type": "color",     "$value": "{semantic.color.text.secondary}" },
        "colorError":    { "$type": "color",     "$value": "{semantic.color.status.error}" },
        "colorDisabled": { "$type": "color",     "$value": "{semantic.color.text.disabled}" },
        "fontSize":      { "$type": "dimension", "$value": "{semantic.typography.caption.fontSize}" }
      },

      "padding": {
        "sm": {
          "y": { "$type": "dimension", "$value": "8px"  },
          "x": { "$type": "dimension", "$value": "14px" }
        },
        "md": {
          "y": { "$type": "dimension", "$value": "12px" },
          "x": { "$type": "dimension", "$value": "14px" }
        },
        "lg": {
          "y": { "$type": "dimension", "$value": "16px" },
          "x": { "$type": "dimension", "$value": "14px" }
        }
      },

      "paddingFilled": {
        "sm": {
          "top":    { "$type": "dimension", "$value": "20px" },
          "bottom": { "$type": "dimension", "$value": "5px"  }
        },
        "md": {
          "top":    { "$type": "dimension", "$value": "24px" },
          "bottom": { "$type": "dimension", "$value": "9px"  }
        },
        "lg": {
          "top":    { "$type": "dimension", "$value": "27px" },
          "bottom": { "$type": "dimension", "$value": "11px" }
        }
      },

      "icon": {
        "color":         { "$type": "color", "$value": "{semantic.color.text.secondary}" },
        "colorDisabled": { "$type": "color", "$value": "{semantic.color.text.disabled}" }
      },

      "menu": {
        "background":   { "$type": "color",     "$value": "{semantic.color.surface.default}" },
        "borderRadius": { "$type": "dimension", "$value": "{semantic.radius.sm}" }
      },

      "menuItem": {
        "color":                  { "$type": "color", "$value": "{semantic.color.text.primary}" },
        "colorSelected":          { "$type": "color", "$value": "{semantic.color.brand.primary}" },
        "colorDisabled":          { "$type": "color", "$value": "{semantic.color.text.disabled}" },
        "background":             { "$type": "color", "$value": "transparent" },
        "backgroundHover":        { "$type": "color", "$value": "{semantic.color.action.hover}" },
        "backgroundSelected":     { "$type": "color", "$value": "{semantic.color.brand.primarySoft}" },
        "backgroundSelectedHover":{ "$type": "color", "$value": "{semantic.color.brand.primaryLight}" },
        "backgroundDisabled":     { "$type": "color", "$value": "transparent" },
        "fontSize": {
          "sm": { "$type": "dimension", "$value": "{semantic.typography.body2.fontSize}" },
          "md": { "$type": "dimension", "$value": "{semantic.typography.body1.fontSize}" },
          "lg": { "$type": "dimension", "$value": "{semantic.typography.body1.fontSize}" }
        },
        "padding": {
          "sm": {
            "y": { "$type": "dimension", "$value": "6px"  },
            "x": { "$type": "dimension", "$value": "12px" }
          },
          "md": {
            "y": { "$type": "dimension", "$value": "8px"  },
            "x": { "$type": "dimension", "$value": "16px" }
          },
          "lg": {
            "y": { "$type": "dimension", "$value": "10px" },
            "x": { "$type": "dimension", "$value": "16px" }
          }
        }
      }
    }
  }
}
